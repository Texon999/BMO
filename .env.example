# Encontrar dispositivios de audio y de salida
BMO_CAMERA_INDEX=0
BMO_MIC_DEVICE=-1
BMO_OUTPUT_DEVICE=-1
BMO_HEADLESS=false

# Visión
BMO_VISION_PROCESS_EVERY_N=1
BMO_BRAIN_CONTEXT_HOT_RELOAD=true

# Voz
BMO_WHISPER_MODEL=base
BMO_WHISPER_LANG=es
BMO_STT_BEAM_SIZE=2
BMO_STT_BEST_OF=2
BMO_SAMPLE_RATE=16000
BMO_VAD_THRESHOLD=0.015
BMO_VAD_SILENCE_SEC=1.2
BMO_VAD_MAX_SEC=10.0
BMO_VAD_MIN_SEC=0.3
BMO_CHUNK_SEC=0.05

# Configuraciones de Ollama
BMO_LLM_MODEL=qwen2.5:1.5b
BMO_LLM_KEEP_ALIVE=-1
BMO_LLM_NUM_THREAD=4
BMO_LLM_NUM_PREDICT=80
BMO_LLM_TEMPERATURE=0.7
BMO_LLM_TOP_K=20
BMO_LLM_TOP_P=0.85
BMO_LLM_REPEAT_PENALTY=1.1
